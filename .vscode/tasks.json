{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Run API",
      "type": "process",
      "command": "${workspaceFolder}\\Backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\Backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "application",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend: Run App",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "application",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Backend: Tests",
      "type": "process",
      "command": "${workspaceFolder}\\Backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\Backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Tests",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build",
      "type": "process",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
